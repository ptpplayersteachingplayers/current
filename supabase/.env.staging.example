# Staging secrets for the edge functions. Copy to .env.staging and fill in.
#   supabase secrets set --env-file .env.staging
#
# Test-mode keys only. Nothing in this file belongs in client code, in the
# repository, or in the browser.

# ---- Supabase (from Project Settings → API) ---------------------------------
SUPABASE_URL=https://yzxcfetglsbaklpburmb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (test mode) -----------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
# Filled in after you create the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_

# ---- The scheduled-jobs endpoint --------------------------------------------
# Any long random string. The /jobs function refuses a request without it.
PTP_JOB_SECRET=

# ---- The agent module (only if you installed it) ----------------------------
# modules/agent/install.sh install — leave these unset otherwise.
# AGENT_MODEL_KEY=
# AGENT_MODEL=
# QUO_WEBHOOK_SECRET=
# EMAIL_WEBHOOK_SECRET=
# HUBSPOT_TOKEN=
